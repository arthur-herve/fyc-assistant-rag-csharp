<Project Sdk="Microsoft.NET.Sdk">
  <!-- Racine de composition et ligne de commande : c'est le seul projet qui connaît toutes les couches. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>assistant</AssemblyName>
    <RootNamespace>Assistant.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Assistant.Infrastructure/Assistant.Infrastructure.csproj" />
    <InternalsVisibleTo Include="Assistant.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- La lecture stricte est compilée ici en copie interne, comme dans l'infrastructure. Ainsi la ligne de
         commande n'a pas à nommer l'infrastructure : seule Composition la connaît, et InfrastructureLeakTests
         le vérifie. -->
    <Compile Include="../Shared/TextFiles.cs" Link="Shared/TextFiles.cs" />
    <Compile Include="../Shared/JsonText.cs" Link="Shared/JsonText.cs" />
  </ItemGroup>
</Project>
